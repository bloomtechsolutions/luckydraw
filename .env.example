# Postgres connection string (filled in automatically when the Prisma Postgres store is connected to the Vercel project)
DATABASE_URL="postgresql://user:password@host:5432/db?sslmode=require"

# Shared admin password for /admin
ADMIN_PASSWORD="change-me"

# Random string used to sign the admin session cookie (e.g. `openssl rand -base64 32`)
AUTH_SECRET="change-me-too"

# Timezone used to display times and in exports (IANA name)
APP_TIMEZONE="Indian/Maldives"

# Optional: public URL encoded in QR codes (defaults to the request host)
# APP_URL="https://luckydraw.example.com"
